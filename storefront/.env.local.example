# URL del backend RUTA. En dev apunta al servidor local; en producción Render lo inyecta via render.yaml.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Clave de NAVEGADOR de Google Maps, restringida por dominio (referrer).
# No es la del backend (GOOGLE_MAPS_API_KEY, de servidor y restringida por IP).
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
